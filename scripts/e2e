#!/bin/sh
# e2e — the single browser journey (docs/testing.md, Test layers).
# Starts the compose database and the packaged app, waits for health, runs Playwright, and tears
# everything down on every path (resource hygiene, rule 4). Its exit code is the check step's.
#
# The database runs in its own compose project (leave-manager-e2e) with a throwaway volume, so a
# developer's `docker compose up` database is never touched and every run starts from a known state.
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$ROOT"

COMPOSE_PROJECT=leave-manager-e2e
# One set of credentials for both sides: compose would otherwise read .env while the app reads the
# environment, and a developer's .env edit would break this run.
DB_NAME="${DB_NAME:-leave_manager}"
DB_USER="${DB_USER:-leave}"
DB_PASSWORD="${DB_PASSWORD:-leave}"
# A dedicated port: 8080-8082 are taken by unrelated local apps on a developer machine.
APP_PORT="${PORT:-8083}"
LOG="$ROOT/target/e2e-app.log"

JAR=$(ls target/leave-manager-*.jar 2>/dev/null | head -n 1 || true)
if [ -z "$JAR" ]; then
  echo "e2e: no jar in target/ — the build step must run first" >&2
  exit 1
fi

APP_PID=
cleanup() {
  if [ -n "$APP_PID" ]; then
    kill "$APP_PID" 2>/dev/null || true
    wait "$APP_PID" 2>/dev/null || true
  fi
  docker compose -p "$COMPOSE_PROJECT" down -v --remove-orphans >/dev/null 2>&1 || true
}
trap cleanup EXIT INT TERM

# Known state: a run killed halfway must not leak its volume or containers into this one.
docker compose -p "$COMPOSE_PROJECT" down -v --remove-orphans >/dev/null 2>&1 || true
DB_NAME="$DB_NAME" DB_USER="$DB_USER" DB_PASSWORD="$DB_PASSWORD" DB_HOST_PORT=0 \
  docker compose -p "$COMPOSE_PROJECT" up -d --wait db

# Discover the random host port compose assigned (a fixed port can be taken by another project).
DB_PORT=$(docker compose -p "$COMPOSE_PROJECT" port db 5432 | head -n 1 | sed 's/.*://')
[ -n "$DB_PORT" ] || { echo "e2e: could not discover the database port" >&2; exit 1; }

DB_URL="jdbc:postgresql://localhost:$DB_PORT/$DB_NAME" \
DB_USER="$DB_USER" DB_PASSWORD="$DB_PASSWORD" PORT="$APP_PORT" \
SEED_HR_EMAIL="hr@e2e.test" SEED_HR_PASSWORD="hr-e2e-password-123" \
SEED_CEO_EMAIL="ceo@e2e.test" SEED_CEO_PASSWORD="ceo-e2e-password-123" \
  java -jar "$JAR" >"$LOG" 2>&1 &
APP_PID=$!

i=0
while [ "$i" -lt 60 ]; do
  if curl -fsS "http://localhost:$APP_PORT/api/health" >/dev/null 2>&1; then
    break
  fi
  i=$((i + 1))
  sleep 1
done

if ! curl -fsS "http://localhost:$APP_PORT/api/health" >/dev/null 2>&1; then
  echo "e2e: the app did not become healthy — log follows" >&2
  cat "$LOG" >&2 || true
  exit 1
fi

E2E_BASE_URL="http://localhost:$APP_PORT" npm --prefix web run e2e
