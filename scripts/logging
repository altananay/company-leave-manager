#!/bin/sh
# scripts/logging — the optional logging profile's two jobs (spec 0006).
#   config: validate the compose profile without starting a container; the check runs this step.
#   smoke:  bring the stack up in its own compose project, wait for the app/Kibana/Elasticsearch,
#           prove the leave-manager log document (service.name/log.level/message) and the 30-day
#           ILM delete phase, then tear down. `--keep` leaves the stack up for the VERIFY
#           screenshots; `docker compose -p leave-manager-logging --profile logging down -v` cleans.
#
# The stack runs in its own project (`leave-manager-logging`) so `down -v` never touches the
# default dev database (scripts/e2e isolates its DB the same way); its db gets a random host port
# (DB_HOST_PORT=0), so the dev db on 5434 and anything on 8080 (Jenkins) are out of the way. The
# app's host port is whatever compose publishes for the container's 8080 (APP_HOST_PORT, 8085).
set -eu
ROOT=$(cd "$(dirname "$0")/.." && pwd)
cd "$ROOT"

PROJECT=leave-manager-logging
ES_URL="http://127.0.0.1:9200"
KIBANA_URL="http://127.0.0.1:5601"

logging_compose() { DB_HOST_PORT=0 docker compose -p "$PROJECT" --profile logging "$@"; }

fail() { echo "logging: $*" >&2; exit 1; }

config() {
  default_services=$(docker compose config --services | sort | tr '\n' ' ')
  [ "$default_services" = "db " ] || fail "the default profile must start only db, got: $default_services"
  logging_services=$(logging_compose config --services | sort | tr '\n' ' ')
  [ "$logging_services" = "app db elasticsearch filebeat filebeat-setup kibana kibana-setup " ] \
    || fail "the logging profile services changed: $logging_services"
  rendered=$(logging_compose config)
  loopback=$(printf '%s' "$rendered" | grep -c 'host_ip: 127.0.0.1')
  [ "$loopback" -eq 4 ] || fail "expected four loopback ports (app, db, Elasticsearch, Kibana), got $loopback"
  printf '%s' "$rendered" | grep -q 'elasticsearch:9.5.5' || fail "Elasticsearch is not pinned to 9.5.5"
  printf '%s' "$rendered" | grep -q 'kibana:9.5.5' || fail "Kibana is not pinned to 9.5.5"
  printf '%s' "$rendered" | grep -q 'filebeat:9.5.5' || fail "Filebeat is not pinned to 9.5.5"
  printf '%s' "$rendered" | grep -q 'es-data' || fail "the Elasticsearch data volume is missing"
  echo "logging config ok: default=db, profile=app db elasticsearch filebeat filebeat-setup kibana kibana-setup"
}

wait_for() { # <label> <url> <attempts>
  label=$1; url=$2; attempts=$3; i=0
  while [ "$i" -lt "$attempts" ]; do
    if curl -fsS "$url" >/dev/null 2>&1; then return 0; fi
    i=$((i + 1)); sleep 2
  done
  fail "$label did not answer at $url"
}

json_has() { # <label> <url> <grep pattern>
  label=$1; url=$2; pattern=$3; i=0
  while [ "$i" -lt 30 ]; do
    body=$(curl -fsS "$url" 2>/dev/null || true)
    if printf '%s' "$body" | grep -q "$pattern"; then return 0; fi
    i=$((i + 1)); sleep 2
  done
  fail "$label did not contain $pattern"
}

smoke() {
  keep=0
  for arg in "$@"; do [ "$arg" = "--keep" ] && keep=1; done
  cleanup() {
    if [ "$keep" -eq 0 ]; then
      echo "logging: tearing the stack down (pass --keep to leave it up)"
      logging_compose down -v >/dev/null 2>&1 || true
    fi
  }
  trap cleanup EXIT INT TERM
  logging_compose up -d
  app_port=$(logging_compose port app 8080 | sed 's/.*://')
  [ -n "$app_port" ] || fail "the app container publishes no host port"
  app_url="http://127.0.0.1:$app_port"
  wait_for "app health" "$app_url/api/health" 60
  wait_for "elasticsearch" "$ES_URL/_cluster/health" 60
  wait_for "kibana" "$KIBANA_URL/api/status" 60
  json_has "the Kibana data view" "$KIBANA_URL/api/data_views" '"filebeat-'
  json_has "the app log document" \
    "$ES_URL/filebeat-*/_search?q=service.name:leave-manager&size=1&filter_path=hits.hits._source.service" \
    '"name":"leave-manager"'
  json_has "the app log level" \
    "$ES_URL/filebeat-*/_search?q=service.name:leave-manager&size=1&filter_path=hits.hits._source.log.level" \
    '"level":"INFO"'
  json_has "the app log message" \
    "$ES_URL/filebeat-*/_search?q=service.name:leave-manager&size=1&filter_path=hits.hits._source.message" \
    '"message":"'
  json_has "the ILM delete phase" "$ES_URL/_ilm/policy/leave-manager-logs" '"delete":{"min_age":"30d"'
  json_has "the ILM delete action" "$ES_URL/_ilm/policy/leave-manager-logs" '"actions":{"delete":'
  echo "logging smoke ok: app health ($app_url), kibana, log doc (service.name/log.level/message), ILM delete 30d"
}

case "${1:-}" in
  config) config ;;
  smoke) shift; smoke "$@" ;;
  *) fail "usage: scripts/logging {config|smoke [--keep]}" ;;
esac
