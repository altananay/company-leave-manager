# Copy to .env (gitignored) and fill in. Never commit real values.
DB_URL=jdbc:postgresql://localhost:5434/leave_manager
DB_USER=leave
DB_PASSWORD=leave
# Host port of the compose database for manual runs. 5432 is a local PostgreSQL, 5433 belongs to
# another project on this machine; e2e picks a random free port itself.
DB_HOST_PORT=5434
PORT=8080

# Session cookie: idle timeout, and Secure (set to true behind TLS — required in production).
SESSION_IDLE_TIMEOUT=30m
SESSION_COOKIE_SECURE=false

# First accounts created on an empty database (min 12-character passwords). Without these the
# application still starts, but nobody can sign in or create users.
SEED_HR_EMAIL=hr@example.test
SEED_HR_PASSWORD=change-this-hr-password
SEED_CEO_EMAIL=ceo@example.test
SEED_CEO_PASSWORD=change-this-ceo-password
