root = true

# Project style: IntelliJ IDEA defaults, pinned so every editor and the agent see the same bytes.
# No formatter runs in `scripts/check` (docs/conventions.md, Enforced by tooling).

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,js,jsx,ts,tsx,css,scss,html}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{cmd,bat}]
end_of_line = crlf
